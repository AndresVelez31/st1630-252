" height="40" as="geometry"/></mxCell><mxCell id="csv_t" value="&lt;b style=&quot;font-size:13.5px;color:#0F6E56&quot;&gt;Listas de riesgo (CSV)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.8px;color:#232F3E&quot;&gt;Se publican en s3://…/landing/&lt;br&gt;Comercios y dispositivos en lista negra&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="149" width="256" height="60" as="geometry"/></mxCell><mxCell id="kafka" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#185FA5;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="100" y="232" width="424" height="172" as="geometry"/></mxCell><mxCell id="kafka_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="1"><mxGeometry x="108" y="241" width="40" height="40" as="geometry"/></mxCell><mxCell id="kafka_t" value="&lt;b style=&quot;font-size:13.5px;color:#185FA5&quot;&gt;Apache Kafka · 3 brokers KRaft&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.8px;color:#232F3E&quot;&gt;cp-kafka 7.6.0 (Lab 2a)&lt;br&gt;Topic transacciones · 12 particiones · clave id_cliente&lt;br&gt;Replicación 3 · acks=all · min.insync.replicas=2 (CP)&lt;br&gt;Productor idempotente · retención 7 días (replay)&lt;br&gt;Garantía at-least-once&lt;br&gt;Topic transacciones_dlq (mensajes inválidos)&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="154" y="235" width="366" height="166" as="geometry"/></mxCell><mxCell id="kafka_tag" value="streaming" style="rounded=1;arcSize=50;html=1;fillColor=#FFF4E5;strokeColor=#D86613;fontColor=#B4530B;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="382" width="68" height="16" as="geometry"/></mxCell><mxCell id="extract" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#185FA5;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="556" y="232" width="424" height="110" as="geometry"/></mxCell><mxCell id="extract_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="1"><mxGeometry x="564" y="241" width="40" height="40" as="geometry"/></mxCell><mxCell id="extract_t" value="&lt;b style=&quot;font-size:13.5px;color:#185FA5&quot;&gt;Airflow + PySpark (extracción)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.8px;color:#232F3E&quot;&gt;JDBC PostgreSQL → Bronze (diario)&lt;br&gt;S3KeySensor: CSV nuevo en landing/ → Bronze&lt;br&gt;MERGE idempotente · 3 reintentos con espera&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="235" width="366" height="104" as="geometry"/></mxCell><mxCell id="extract_tag" value="batch" style="rounded=1;arcSize=50;html=1;fillColor=#FFF4E5;strokeColor=#D86613;fontColor=#B4530B;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="906" y="320" width="68" height="16" as="geometry"/></mxCell><mxCell id="stream" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#854F0B;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="100" y="430" width="424" height="202" as="geometry"/></mxCell><mxCell id="stream_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="1"><mxGeometry x="108" y="439" width="40" height="40" as="geometry"/></mxCell><mxCell id="stream_t" value="&lt;b style=&quot;font-size:13.5px;color:#854F0B&quot;&gt;Spark Structured Streaming&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.8px;color:#232F3E&quot;&gt;Spark 3.5.1 + Delta 3.1.0 · trigger 5 s&lt;br&gt;Esquema · JSON inválido → DLQ&lt;br&gt;Dedup id_transaccion (watermark 10 min)&lt;br&gt;R1 · P1: ventana 5 min / 1 min (modo update)&lt;br&gt;R2 · P2: dispositivo nuevo y monto &amp;gt; 3× promedio 30 d&lt;br&gt;R3 · P3: lista de riesgo (join con Gold)&lt;br&gt;Checkpoint en S3 junto a los datos&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="154" y="433" width="366" height="196" as="geometry"/></mxCell><mxCell id="stream_tag" value="streaming" style="rounded=1;arcSize=50;html=1;fillColor=#FFF4E5;strokeColor=#D86613;fontColor=#B4530B;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="610" width="68" height="16" as="geometry"/></mxCell><mxCell id="batch" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#854F0B;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="556" y="430" width="424" height="128" as="geometry"/></mxCell><mxCell id="batch_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="1"><mxGeometry x="564" y="439" width="40"