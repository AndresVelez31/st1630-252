=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=5;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0F6E56;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="122" width="268" height="116" as="geometry"/></mxCell><mxCell id="app_tag" value="EC2-A" style="rounded=1;arcSize=50;html=1;fillColor=#E2F0EE;strokeColor=#2E7D78;fontColor=#2E7D78;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="215" width="46" height="17" as="geometry"/></mxCell><mxCell id="pg" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#0F6E56;font-size:14px&quot;&gt;PostgreSQL 16 (operacional)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2A2A2A;line-height:1.35&quot;&gt;Clientes y comercios (relacional)&lt;br&gt;Contenedor que simula la BD de la app&lt;br&gt;Extracción batch diaria&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=5;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0F6E56;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="262" width="268" height="100" as="geometry"/></mxCell><mxCell id="pg_tag" value="EC2-B" style="rounded=1;arcSize=50;html=1;fillColor=#ECE8FA;strokeColor=#5B4BB7;fontColor=#5B4BB7;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="339" width="46" height="17" as="geometry"/></mxCell><mxCell id="csv" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#0F6E56;font-size:14px&quot;&gt;Listas de riesgo (CSV)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2A2A2A;line-height:1.35&quot;&gt;Comercios y dispositivos en lista negra&lt;br&gt;Se publican en S3 landing/&lt;br&gt;Versión nueva periódica&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=5;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0F6E56;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="386" width="268" height="100" as="geometry"/></mxCell><mxCell id="csv_tag" value="AWS por uso" style="rounded=1;arcSize=50;html=1;fillColor=#FFF1D6;strokeColor=#B86E00;fontColor=#B86E00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="208" y="463" width="78" height="17" as="geometry"/></mxCell><mxCell id="kafka" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#185FA5;font-size:14px&quot;&gt;Apache Kafka 3 brokers (KRaft)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2A2A2A;line-height:1.35&quot;&gt;Topic transacciones · 12 particiones&lt;br&gt;Clave id_cliente · replicación 3&lt;br&gt;acks=all · min.insync.replicas=2 (CP)&lt;br&gt;Productor idempotente · retención 7 d&lt;br&gt;Garantía: at-least-once&lt;br&gt;Topic transacciones_dlq (inválidos)&lt;br&gt;Imagen cp-kafka 7.6.0 (Lab 2a)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=5;spacingRight=6;fillColor=#FFFFFF;strokeColor=#185FA5;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="329" y="122" width="268" height="196" as="geometry"/></mxCell><mxCell id="kafka_tag" value="EC2-A" style="rounded=1;arcSize=50;html=1;fillColor=#E2F0EE;strokeColor=#2E7D78;fontColor=#2E7D78;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="545" y="295" width="46" height="17" as="geometry"/></mxCell><mxCell id="extract" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#185FA5;font-size:14px&quot;&gt;Airflow + PySpark (extracción)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2A2A2A;line-height:1.35&quot;&gt;JDBC PostgreSQL → Bronze (diario)&lt;br&gt;Sensor S3: CSV nuevo → Bronze&lt;br&gt;MERGE idempotente (at-least-once)&lt;br&gt;Reintentos 3 · espera exponencial&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=5;spacingRight=6;fillColor=#FFFFFF;strokeColor=#185FA5;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="329" y="340" width="268" height="146" as="geometry"/></mxCell><mxCell id="extract_tag" value="EC2-B" style="rounded=1;arcSize=50;html=1;fillColor=#ECE8FA;strokeColor=#5B4BB7;fontColor=#5B4BB7;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="545" y="463" width="46" height="17" as="geometry"/></mxCell><mxCell id="stream" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#854F0B;font-size:14px&quot;&gt;Spark Structured Streaming 3.5&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2A2A2A;line-height:1.35&quot;&gt;Trigger 5 s · JSON inválido → DLQ&lt;br&gt;Dedup id_transaccion (watermark 10 min)&lt;br&gt;R1 · P1: ventana 5 min / 1 min (update)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;gt;5 tx o &amp;gt;$2.000.000 por cliente&lt;br&gt;R2 · P2: dispositivo nuevo y monto&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;gt;3× promedio 30 d (join con Gold)&lt;br&gt;R3 · P3: lista de riesgo (join)&lt;br&gt;Checkpoint en S3 · restart automático&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=5;spacingRight=6;fillColor=#FFFFFF;strokeColor=#854F0B;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="634" y="122" width="268" height="226" as="geometry"/></mxCell><mxCell id="stream_tag" value="EC2-A" style="rounded=1;arcSize=50;html=1;fillColor=#E2F0EE;strokeColor=#2E7D78;fontColor=#2E7D78;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="325" width="46" height="17" as="geometry"/></mxCell><mxCell id="batch" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#854F0B;font-size:14px&quot;&gt;Spark batch (PySpark + Delta)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2A2A2A;line-height:1.35&quot;&gt;Corre dentro de Airflow (patrón Lab 4a)&lt;br&gt;Silver → Gold cada 10 min&lt;br&gt;Dimensiones SCD2 + hechos (MERGE)&lt;br&gt;Métricas P4–P6 · OPTIMIZE ZORDER&lt;br&gt;Reproceso por rule_version (solo Gold)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=5;spacingRight=6;fillColor=#FFFFFF;strokeColor=#854F0B;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="634" y="372" width="268" height="152" as="geometry"/></mxCell><mxCell id="batch_tag" value="EC2-B" style="rounded=1;arcSize=50;html=1;fillColor=#ECE8FA;strokeColor=#5B4BB7;fontColor=#5B4BB7;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="501" width="46" height="17" as="geometry"/></mxCell><mxCell id="bronze" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#534AB7;font-size:14px&quot;&gt;BRONZE · Delta Lake en S3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2A2A2A;line-height:1.35&quot;&gt;Crudo, append-only · offset Kafka&lt;br&gt;ingest_ts · catálogos y listas&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=5;spacingRight=6;fillColor=#FFFFFF;strokeColor=#534AB7;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="939" y="122" width="268" height="82" as="geometry"/></mxCell><mxCell id="bronze_tag" value="AWS por uso" style="rounded=1;arcSize=50;html=1;fillColor=#FFF1D6;strokeColor=#B86E00;fontColor=#B86E00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1123" y="181" width="78" height="17" as="geometry"/></mxCell><mxCell id="silver" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#534AB7;font-size:14px&quot;&gt;SILVER · Delta Lake en S3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2A2A2A;line-height:1.35&quot;&gt;Limpio, tipado, sin duplicados (MERGE)&lt;br&gt;Datos personales con HMAC-SHA-256&lt;br&gt;Cuarentena con motivo · alertas&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=5;spacingRight=6;fillColor=#FFFFFF;strokeColor=#534AB7;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="939" y="224" width="268" height="112" as="geometry"/></mxCell><mxCell id="silver_tag" value="AWS por uso" style="rounded=1;arcSize=50;html=1;fillColor=#FFF1D6;strokeColor=#B86E00;fontColor=#B86E00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1123" y="313" width="78" height="17" as="geometry"/></mxCell><mxCell id="gold" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#534AB7;font-size:14px&quot;&gt;GOLD · Delta Lake en S3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2A2A2A;line-height:1.35&quot;&gt;Esquema en estrella, particionado por fecha&lt;br&gt;fact_transacciones · fact_alertas&lt;br&gt;dim_cliente (SCD2) · dim_comercio&lt;br&gt;dim_dispositivo · dim_tiempo · dim_regla&lt;br&gt;Time travel 90 días (auditoría)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=5;spacingRight=6;fillColor=#FFFFFF;strokeColor=#534AB7;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="939" y="356" width="268" height="168" as="geometry"/></mxCell><mxCell id="gold_tag" value="AWS por uso" style="rounded=1;arcSize=50;html=1;fillColor=#FFF1D6;strokeColor=#B86E00;fontColor=#B86E00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1123" y="501" width="78" height="17" as="geometry"/></mxCell><mxCell id="ddb" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#534AB7;font-size:14px&quot;&gt;Amazon DynamoDB (on-demand)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2A2A2A;line-height:1.35&quot;&gt;Tabla alertas_fraude&lt;br&gt;PK id_cliente · SK ts_alerta#regla&lt;br&gt;PutItem condicional (clave determinista)&lt;br&gt;Lectura eventual para analistas (AP)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=5;spacingRight=6;fillColor=#FFFFFF;strokeColor=#534AB7;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="939" y="548" width="268" height="128" as="geometry"/></mxCell><mxCell id="ddb_tag" value="AWS por uso" style="rounded=1;arcSize=50;html=1;fillColor=#FFF1D6;strokeColor=#B86E00;fontColor=#B86E00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1123" y="653" width="78" height="17" as="geometry"/></mxCell><mxCell id="metabase" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#993556;font-size:14px&quot;&gt;Metabase&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2A2A2A;line-height:1.35&quot;&gt;Dashboards de fraude por comercio,&lt;br&gt;ciudad y franja horaria&lt;br&gt;Conector Amazon Athena&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=5;spacingRight=6;fillColor=#FFFFFF;strokeColor=#993556;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1244" y="122" width="268" height="96" as="geometry"/></mxCell><mxCell id="metabase_tag" value="EC2-B" style="rounded=1;arcSize=50;html=1;fi