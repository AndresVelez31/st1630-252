ative="1" as="geometry"><mxPoint x="400" y="937" as="sourcePoint"/><mxPoint x="480" y="937" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="Alertas de fraude (baja latencia)" style="text;html=1;align=left;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="492" y="925" width="520" height="24" as="geometry"/></mxCell><mxCell id="c61" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#1F5FA8;strokeWidth=2;dashed=1;dashPattern=2 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="937" as="sourcePoint"/><mxPoint x="920" y="937" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" value="Lookup de dimensiones desde Gold (join stream-static)" style="text;html=1;align=left;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="932" y="925" width="520" height="24" as="geometry"/></mxCell><mxCell id="c63" value="Latencia objetivo: evento → alerta &lt; 30 s (P95) · evento → Gold &lt; 15 min. Almacenamiento de objetos: MinIO (compatible S3, un nodo en local). Todo en Docker Compose." style="text;html=1;align=left;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="10" y="958" width="1580" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>