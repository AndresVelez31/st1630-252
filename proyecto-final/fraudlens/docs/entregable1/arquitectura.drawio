<mxfile host="app.diagrams.net"><diagram id="fraudlens-arq" name="Arquitectura FraudLens"><mxGraphModel dx="1530" dy="1030" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1530" pageHeight="1030" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;FraudLens · Arquitectura de datos por capas&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=21;fontColor=#1F1F1F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="12" y="8" width="1100" height="28" as="geometry"/></mxCell><mxCell id="subtitle" value="Detección de fraude en pagos digitales (fintech colombiana) · streaming + batch sobre lakehouse Bronze/Silver/Gold · despliegue híbrido en AWS Academy (us-east-1)" style="text;html=1;fillColor=none;strokeColor=none;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#5F5E5A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="12" y="36" width="1300" height="20" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;arcSize=3;fillColor=#EEF6F2;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="12" y="66" width="292" height="712" as="geometry"/></mxCell><mxCell id="hdr0" value="1 · FUENTE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F6E56;strokeColor=#0F6E56;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="74" width="268" height="34" as="geometry"/></mxCell><mxCell id="lane1" value="" style="rounded=1;arcSize=3;fillColor=#EEF3FA;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="317" y="66" width="292" height="712" as="geometry"/></mxCell><mxCell id="hdr1" value="2 · INGESTIÓN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#185FA5;strokeColor=#185FA5;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFami