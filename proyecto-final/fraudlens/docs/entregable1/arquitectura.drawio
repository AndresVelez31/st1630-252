<mxfile host="app.diagrams.net"><diagram id="fraudlens-arq" name="Arquitectura FraudLens"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="1 · FUENTE" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#2B2B2B;strokeColor=#2B2B2B;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="15" width="284" height="38" as="geometry"/></mxCell><mxCell id="c4" value="2 · INGESTIÓN" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#2B2B2B;strokeColor=#2B2B2B;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="334" y="15" width="284" height="38" as="geometry"/></mxCell><mxCell id="c5" value="3 · PROCESAMIENTO" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#2B2B2B;strokeColor=#2B2B2B;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="658" y="15" width="284" height="38" as="geometry"/></mxCell><mxCell id="c6" value="4 · ALMACENAMIENTO" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#2B2B2B;strokeColor=#2B2B2B;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="982" y="15" width="284" height="38" as="geometry"/></mxCell><mxCell id="c7" value="5 · CONSUMO" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#2B2B2B;strokeColor=#2B2B2B;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1306" y="15" width="284" height="38" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;App móvil / API de pagos&lt;/b&gt;&lt;br&gt;Eventos de transacción (JSON)&lt;br&gt;~1.000 ev/s (pico 5.000 ev/s)&lt;br&gt;Simulado con productor Faker" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="10" y="70" width="284" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;PostgreSQL 16 (operacional)&lt;/b&gt;&lt;br&gt;Catálogos de clientes y&lt;br&gt;comercios · carga batch diaria" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="10" y="215" width="284" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Listas de riesgo (CSV)&lt;/b&gt;&lt;br&gt;Comercios y dispositivos en&lt;br&gt;lista negra · versión periódica" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="10" y="415" width="284" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Apache Kafka (KRaft, 3 brokers)&lt;/b&gt;&lt;br&gt;Topic transacciones · 12 partic.&lt;br&gt;Clave id_cliente · 3 réplicas&lt;br&gt;acks=all · min.insync.replicas=2&lt;br&gt;Idempotente · retención 7 días&lt;br&gt;At-least-once · CP&lt;br&gt;DLQ: transacciones_dlq" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="334" y="70" width="284" height="170" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Airflow + PySpark (extract)&lt;/b&gt;&lt;br&gt;Lee PostgreSQL (JDBC) y CSV&lt;br&gt;Escribe Parquet en landing&lt;br&gt;(MinIO) · diario o con CSV nuevo&lt;br&gt;At-least-once + MERGE" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="334" y="380" width="284" height="115" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Spark Structured Streaming&lt;/b&gt;&lt;br&gt;Lee Kafka · parsea JSON&lt;br&gt;JSON inválido → DLQ&lt;br&gt;Dedup id_transaccion (WM 10 min)&lt;br&gt;Calidad → cuarentena (Silver)&lt;br&gt;Trigger 5 s · salida update&lt;br&gt;R1 · P1: ventana 5 min/cliente&lt;br&gt;R2 · P2: dispositivo nuevo y&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;monto &amp;gt;3× prom. 30 d (Gold)&lt;br&gt;R3 · P3: lista de riesgo (join)&lt;br&gt;Alertas: upsert por _id&lt;br&gt;Checkpoint en MinIO" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="658" y="70" width="284" height="245" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Spark batch (PySpark)&lt;/b&gt;&lt;br&gt;Landing → Bronze → Silver&lt;br&gt;Silver → Gold (star schema)&lt;br&gt;Tasa de fraude, P95, top 10&lt;br&gt;Reproceso por rule_version&lt;br&gt;Disparado por DAGs Airflow" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="698" y="380" width="244" height="135" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;BRONZE · Delta Lake en MinIO&lt;/b&gt;&lt;br&gt;Crudo, append-only&lt;br&gt;Linaje: offset Kafka + ingest_ts" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="982" y="70" width="284" height="85" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;SILVER · Delta Lake en MinIO&lt;/b&gt;&lt;br&gt;Limpio, tipado, dedup (MERGE)&lt;br&gt;Datos personales con hash&lt;br&gt;Cuarentena y tabla de alertas" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="982" y="190" width="284" height="105" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;GOLD · Delta Lake en MinIO&lt;/b&gt;&lt;br&gt;Star schema consultable&lt;br&gt;fact_transacciones · fact_alertas&lt;br&gt;dim_cliente (SCD2) · dim_comercio&lt;br&gt;dim_dispositivo · dim_tiempo&lt;br&gt;dim_regla&lt;br&gt;Actualizado cada 10 min&lt;br&gt;Time travel 90 días" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="982" y="330" width="284" height="170" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;MongoDB (replica set, 3 nodos)&lt;/b&gt;&lt;br&gt;alertas_fraude (baja latencia)&lt;br&gt;Escritura w=majority (CP)&lt;br&gt;Lectura secondaryPreferred (AP)&lt;br&gt;Upsert por _id, sin duplicados" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="982" y="535" width="284" height="125" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Metabase&lt;/b&gt;&lt;br&gt;Dashboards de fraude por&lt;br&gt;comercio, ciudad y hora" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1306" y="70" width="284" height="85" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Trino (motor de consulta)&lt;/b&gt;&lt;br&gt;SQL sobre Delta Lake (Gold)&lt;br&gt;Responde P4, P5 y P6&lt;br&gt;Conector delta_lake" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1306" y="190" width="284" height="105" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;API de alertas (FastAPI)&lt;/b&gt;&lt;br&gt;GET /alertas por cliente,&lt;br&gt;regla y fecha&lt;br&gt;Webhook al equipo de fraude&lt;br&gt;Latencia alerta P95 &amp;lt; 30 s" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1306" y="535" width="284" height="125" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;ORQUESTACIÓN · Apache Airflow 2.x&lt;/b&gt; — cada tarea depende de la anterior (falla limpia si hay error upstream; 3 reintentos con espera creciente)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;strokeColor=#222222;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="10" y="705" width="1580" height="205" as="geometry"/></mxCell><mxCell id="c23" value="El job de streaming corre continuo (Spark standalone: 1 master + 2 workers); un sensor de Airflow verifica que esté activo." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="880" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;DAG catalogos_diario&lt;/b&gt; · diario o al llegar un CSV" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="25" y="770" width="520" height="40" as="geometry"/></mxCell><mxCell id="c25" value="extract_batch" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=14;align=center;verticalAlign=middle;strokeColor=#222222;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="500" y="771.0" width="215" height="38" as="geometry"/></mxCell><mxCell id="c26" value="load_bronze" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=14;align=center;verticalAlign=middle;strokeColor=#222222;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="755" y="771.0" width="215" height="38" as="geometry"/></mxCell><mxCell id="c27" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=2;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="spark_silver" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=14;align=center;verticalAlign=middle;strokeColor=#222222;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="771.0" width="215" height="38" as="geometry"/></mxCell><mxCell id="c29" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=2;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;DAG fraude_pipeline&lt;/b&gt; · cada 10 minutos" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="25" y="830" width="520" height="40" as="geometry"/></mxCell><mxCell id="c31" value="gold_dimensiones" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=14;align=center;verticalAlign=middle;strokeColor=#222222;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="500" y="831.0" width="215" height="38" as="geometry"/></mxCell><mxCell id="c32" value="gold_fact" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=14;align=center;verticalAlign=middle;strokeColor=#222222;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="755" y="831.0" width="215" height="38" as="geometry"/></mxCell><mxCell id="c33" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=2;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="quality_checks" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=14;align=center;verticalAlign=middle;strokeColor=#222222;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="831.0" width="215" height="38" as="geometry"/></mxCell><mxCell id="c35" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=2;" edge="1" parent="1" source="c32" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="refresh_metabase" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=14;align=center;verticalAlign=middle;strokeColor=#222222;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1265" y="831.0" width="215" height="38" as="geometry"/></mxCell><mxCell id="c37" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=2;" edge="1" parent="1" source="c34" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="294" y="125" as="sourcePoint"/><mxPoint x="334" y="125" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;stro